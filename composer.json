{
    "name": "nvl/filterable",
    "description": "Validated, reusable Eloquent filtering and sorting for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "filtering",
        "sorting"
    ],
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^5.0",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Filterable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Filterable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Filterable\\Providers\\FilterableServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "homepage": "https://github.com/nvl-laravel-suite/filterable",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/filterable",
        "docs": "https://github.com/nvl-laravel-suite/filterable#readme",
        "issues": "https://github.com/nvl-laravel-suite/filterable/issues",
        "security": "https://github.com/nvl-laravel-suite/filterable/security/policy"
    }
}
